---
// "The overnight call calculator" as served (blog-handoff.md sections 4 and 5.2). The opening night (the design's
// defaults) is printed in full: the answer, the waterfall, the three finds, the grid of every case. The same
// functions the block script imports (src/blog-tools/call-view.mjs) write it, so the script only moves what is
// already here. The controls are hidden until script runs them; with script off the answer and the grid show.
import { DEFAULTS, PRESETS, SLIDERS, presetMatches, runOvernight, findsMet, heatGrid } from "../../blog-tools/overnight-call.mjs";
import { headlineHtml, sentenceHtml, breakEvenHtml, whyHtml, pricedHtml, summaryHtml, sliderText, breakEvenMarker, findsHtml, heatHtml, waterfallSvg, waterfallLabel } from "../../blog-tools/call-view.mjs";

const r = runOvernight(DEFAULTS);
if (!r.ok) throw new Error("the design's opening night must be valid");
const st = sliderText(r);
const marker = breakEvenMarker(r);
const found = findsMet(r.inputs, r);
const grid = heatGrid(r.inputs, r);
const FIELDS = [
  ["t-s", "stock", "Stock price, $", "Enter a price above 0."],
  ["t-k", "strike", "Strike, $", "Enter a strike above 0."],
  ["t-d", "daysToExpiry", "Days to expiry", "Enter 1 to 730 days."],
  ["t-ivb", "ivNowPct", "Implied volatility now, %", "Enter 1 to 500."],
];
const SL = [
  ["t-m", "movePct", "Stock moves", "move"],
  ["t-iva", "ivAfterPct", "Implied volatility goes to", "iv"],
  ["t-dd", "daysPass", "Days that pass", "days"],
];
---
<div data-call>
  <p class="sim-nojs" data-nojs>The sliders need script. The opening night is worked out below.</p>
  <section class="blk tool">
    <div class="tl" data-controls hidden>
      <div class="tpre"><p class="lab">Start with a night</p>
        <div class="chips" role="group" aria-label="Example nights" style="margin:0">
          {PRESETS.map((p, i) => <button type="button" class="chip" data-p={i} aria-pressed={presetMatches(r.inputs, p) ? "true" : "false"}>{p.label}</button>)}
        </div>
      </div>
      <div class="plate tctl">
        <p class="tstep">Then change the night<span>Drag, or tap − and +.</span></p>
        <div>
          {SL.map(([id, key, label, k]) => {
            const s = SLIDERS[key];
            return (
              <div class="sx">
                <div class="sx-h"><label for={id}>{label}</label><output id={`${id}-v`} for={id}>{st[k].value}</output><span class={`eff ${st[k].tone}`} id={`${id}-e`}>{st[k].effect}</span></div>
                <div class="sx-r">
                  <button type="button" class="stp" data-for={id} data-d="-1" aria-label={`${label}, down`}>−</button>
                  <div class="sx-t"><input type="range" id={id} min={s.min} max={s.max} step={s.step} value={DEFAULTS[key]} />{id === "t-m" && <i class="be" id="tbemk" hidden={!marker} style={marker ? `left:${marker.left}` : undefined}>{marker?.text}</i>}</div>
                  <button type="button" class="stp" data-for={id} data-d="1" aria-label={`${label}, up`}>+</button>
                </div>
              </div>
            );
          })}
        </div>
        <details class="tcall" id="tcall" data-fold><summary><span data-sum set:html={summaryHtml(r)}></span><i>Change the call</i></summary>
          <div class="tform">
            {FIELDS.map(([id, key, label]) => <label class="fld" for={id}>{label}<input id={id} type="number" inputmode="decimal" step="any" value={DEFAULTS[key]} aria-describedby={`${id}-x`} /><small id={`${id}-x`} hidden></small></label>)}
          </div>
          <p class="fine" style="margin:12px 0 0">Implied volatility is the IV column on an option chain.</p>
          <div class="row" style="margin-top:12px"><button class="btn alt" type="button" data-reset>Back to the example call</button></div>
        </details>
      </div>
    </div>
    <div class="tr">
      <div class="tans" aria-live="polite">
        <p class="thead" data-head set:html={headlineHtml(r)}></p>
        <p class="tsent" data-sent set:html={sentenceHtml(r)}></p>
        <p class="tsent" data-be set:html={breakEvenHtml(r)}></p>
        <div class="why"><p data-why set:html={whyHtml(r)}></p><p data-em set:html={pricedHtml(r)}></p></div>
        <p class="twarn" data-bad hidden>One of the call's numbers is out of range. The result below is the last one that was valid.</p>
      </div>
      <div class="plate twfp"><p class="lab">Where the change came from</p>
        <svg class="ch" data-wf viewBox="0 0 600 270" role="img" aria-label={waterfallLabel(r)} set:html={waterfallSvg(r, 600)}></svg>
      </div>
      <p class="stamp tst"><span><b>As of</b> the numbers you set</span><span><b>Source</b> computed in this page. Nothing is sent anywhere.</span></p>
    </div>
  </section>
  <section class="blk">
    <p class="lab">Three things to find <span data-fc style="font-weight:400">· {found.filter(Boolean).length} of 3 found</span></p>
    <h2 class="bt">Move the sliders until each one happens.</h2>
    <ol class="finds" data-finds aria-live="polite" set:html={findsHtml(found)}></ol>
  </section>
  <section class="blk">
    <p class="lab">The whole night at a glance</p>
    <h2 class="bt">Every stock move against every volatility.</h2>
    <p>Each cell is the call's change by the morning. Tap a cell to load it above.</p>
    <div class="plate"><div class="tw"><table class="heat" data-heat set:html={heatHtml(grid, r.inputs, false)}></table></div>
      <p class="stamp"><span><b>As of</b> the call you set</span><span><b>Source</b> computed in this page</span></p></div>
  </section>
</div>
