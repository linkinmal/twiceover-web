---
// A list page: the index, a topic page, and either's later pages. A subject filter is a plain page at its
// own address, so it works with script off (handoff 6; ADR 1090 Decision 7). On the unfiltered index the
// nameplate is the h1; on a filter page it becomes a paragraph and the filter's name is the h1 (handoff 4a).
import BlogBase from "../../layouts/BlogBase.astro";
import Nameplate from "./Nameplate.astro";
import Tile from "./Tile.astro";
import { TOPIC_LABELS, TOPIC_DESCRIPTIONS, INDEX_DESCRIPTION } from "../../blog/labels.mjs";

interface Props {
  title: string;
  description: string;
  topic?: string; // the filtered topic, when this is a topic page
  topics: string[]; // topics that have a published post, in order
  items: any[]; // this page's posts
  numbers: Map<string, string>;
  basePath: string; // "/blog" or "/blog/topic/<topic>"
  pageNo: number;
  pageCount: number;
}
const { title, description, topic, topics, items, numbers, basePath, pageNo, pageCount } = Astro.props;
const href = (n: number) => (n === 1 ? basePath : `${basePath}/page/${n}`);
const label = topic ? TOPIC_LABELS[topic as keyof typeof TOPIC_LABELS] : "";
const ds = topic ? TOPIC_DESCRIPTIONS[topic as keyof typeof TOPIC_DESCRIPTIONS] : INDEX_DESCRIPTION;
---
<BlogBase title={title} description={description}>
  <div class="page">
    <section class="mast">
      {topic ? (
        <>
          <Nameplate />
          <h1 class="fh">{label}</h1>
        </>
      ) : (
        <Nameplate heading />
      )}
      <p class="ds">{ds}</p>
    </section>
    <div class="filt" id="topics" role="group" aria-label="Filter posts by topic">
      <a href="/blog" aria-current={!topic ? "page" : undefined}>All</a>
      <i aria-hidden="true"></i>
      {topics.map((t) => <a href={`/blog/topic/${t}`} aria-current={t === topic ? "page" : undefined}>{TOPIC_LABELS[t as keyof typeof TOPIC_LABELS]}</a>)}
    </div>
    <div class="wall">
      {items.map((p, i) => <Tile slug={p.id} number={numbers.get(p.id)!} data={p.data} lead={i === 0 && !topic && pageNo === 1} />)}
    </div>
    {pageCount > 1 && (
      <nav class="pnav" aria-label="Pages">
        {pageNo > 1 && <a href={href(pageNo - 1)} rel="prev">Newer posts<b>Page {pageNo - 1} of {pageCount}</b></a>}
        {pageNo < pageCount && <a href={href(pageNo + 1)} rel="next">Older posts<b>Page {pageNo + 1} of {pageCount}</b></a>}
      </nav>
    )}
  </div>
</BlogBase>
