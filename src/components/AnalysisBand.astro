---
// Flowing analysis band (site-prelaunch.md §2 Home; homepage v3.4, stock-analyst-platform#3829 —
// build reference ai-team/design/assets/homepage-3818-v3-2026-09-23.html, ADR 0991). The thirteen
// analysis sections in the band's order, each with the plan that adds it, continuous right-to-left
// scroll — full-bleed, one illustrative sample analysis.
//
// The cards read src/data/sections.mjs, the site's one section list (ADR 0990: section names and
// plan placement "must never disagree with /pricing or the homepage band"). Nothing here types a
// section name, a tagline, a plan or the count.
//
// Both the visible set and its loop duplicate are server-rendered (no client-side DOM injection):
// the page has real content with no JS at all; public/js/analysis-band.js only pauses the CSS
// animation off-screen (battery/CPU courtesy, not a functional requirement).
import AnalysisMini from "./AnalysisMini.astro";
import { SECTIONS, planTag } from "../data/sections.mjs";

const total = SECTIONS.length;
---
<section class="band" aria-labelledby="band-heading">
  <div class="band__head">
    <h2 id="band-heading" class="type-heading-1">Inside an analysis</h2>
  </div>
  <div class="band__wrap">
    <div class="band__track" id="bandTrack">
      {[false, true].map((duplicate) =>
        SECTIONS.map((sec, i) => (
          <div class="band__cell" aria-hidden={duplicate ? "true" : undefined}>
            <p class="band__cell-name">
              {sec.name}
              {planTag(sec) && <span class="plan-tag">{planTag(sec)}</span>}
              <span class="band__cell-index">{i + 1}/{total}</span>
            </p>
            <p class="band__cell-tag">{sec.tagline}</p>
            <AnalysisMini kind={sec.key} />
          </div>
        )),
      )}
    </div>
  </div>
</section>

{/* Progressive enhancement ONLY — the band scrolls via CSS (@keyframes band-flow,
    gated to prefers-reduced-motion: no-preference) with no JS at all. The one thing on
    top — pausing the animation when the band is off-screen — lives in
    public/js/analysis-band.js, moved out of an `is:inline` block verbatim so the site's
    CSP keeps `script-src 'self'` strict with no inline exception
    (stock-analyst-platform#2976, consult 0811 Amendment 1). `defer` runs it after parse;
    it is null-guarded and reads no layout, so the timing is equivalent to inline here. */}
<script src="/js/analysis-band.js" defer></script>
