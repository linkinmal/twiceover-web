---
/**
 * The held position, as a card (homepage v3.4, stock-analyst-platform#3829): the page's canonical
 * NVDA bull call spread (`SPREAD`), its payoff at expiry drawn by the site's ported payoff chart, the
 * user's option target, and the three figures. Two placements:
 *   - `deck`    — "Your bull call spread · yours · the position page".
 *   - `section` — "Your position", with the four tabs named and the Paths line beneath.
 * The deck card shows the payoff chart's desktop state at every width (site.css `.dcard .pf-chart--*`).
 *
 * The rule line's percent is bare, matching the row's own P&L% (stock-analyst-platform#3963 item 2
 * ruling): "of max" is never a real basis in this system — the rule-state strip only recognizes "%
 * of cost" and "% of credit received" — and it reads as false below the cap regardless.
 *
 * `.pos-pl` carries its own sign class (Designer's PR #89 review, non-blocking): the canonical
 * spread is always profitable in this fixture, which hid that the color never actually depended on
 * the figure's own sign — the same class of bug PortfolioCard's header had.
 */
import PayoffChart from "./PayoffChart.astro";
import { PORTFOLIO, SPREAD, money, signedMoney, signedPct } from "../charts/site-fixture.mjs";

interface Props {
  variant: "deck" | "section";
}
const { variant } = Astro.props;
const tone = (v: number) => (v < 0 ? "dn" : "up");
const nvda = PORTFOLIO.rows.find((r) => r.ticker === "NVDA");
const maxProfit = (SPREAD.upperStrike - SPREAD.lowerStrike) * SPREAD.multiplier * SPREAD.contracts - SPREAD.netDebit;
const head = variant === "deck"
  ? { ttl: "Your bull call spread", note: "yours · the position page" }
  : { ttl: "Your position", note: "Position · Rules · Scenarios · Paths" };
---

<div class:list={["dcard", { "pv__card": variant === "section" }]} {...(variant === "deck" ? { role: "group", "aria-roledescription": "slide", "aria-label": "Your position", "data-key": "position" } : {})}>
  <div class="dcard__hd"><span class="dcard__ttl">{head.ttl}</span><span class="dcard__note">{head.note}</span></div>
  <div class="pos-hd">
    <div><span class="pc-tk">NVDA</span> <span class="pc-st">Bull call spread · <span class="nw">{SPREAD.contracts} × {SPREAD.expiry} {SPREAD.lowerStrike}/{SPREAD.upperStrike} C</span></span></div>
    <div class={`pos-pl ${tone(nvda.pnl)}`}>{signedMoney(nvda.pnl)} <small>{signedPct(nvda.pct)} open</small></div>
  </div>
  <div class="dcard__fill"><PayoffChart /></div>
  <div class="pv__rule"><span>◐ Your option target 60%</span><span>approaching · {signedPct(nvda.pct)}</span></div>
  <div class="figs3">
    <div><span>Max loss</span><b>{signedMoney(-SPREAD.netDebit)}</b></div>
    <div><span>Breakeven</span><b>{money(SPREAD.breakeven)}</b></div>
    <div><span>Max profit</span><b>{signedMoney(maxProfit)}</b></div>
  </div>
  {variant === "section" && <div class="pv__paths">Paths: make no change · close · reduce · roll, each with its math</div>}
</div>
