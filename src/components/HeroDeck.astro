---
/**
 * The hero deck (homepage v3.4, stock-analyst-platform#3829; site-prelaunch.md §2 "Hero deck"; build
 * reference `ai-team/design/assets/homepage-3818-v3-2026-09-23.html`). Product views stacked as a
 * deck, one in front, advancing every 5s — "opening on a random card, advancing every 5s, pausable
 * (WCAG 2.2.2), reduced-motion static."
 *
 * Progressive enhancement. The markup is the deck's FIRST state, server-rendered: card 0 in front
 * (`data-pos="0"`), the rest stacked behind and `aria-hidden`, so with no script it is a correct,
 * static picture of the Outlook. The controls ship `hidden` and only appear once
 * `public/js/hero-deck.js` runs, because a Pause button that pauses nothing is a false control.
 * The script only reorders these cards and toggles attributes — it reads no field and opens no
 * connection (ci/check-entry-box.mjs scans it, declared in EXPECTED_SCRIPTS).
 *
 * Eight cards (v2.51, stock-analyst-platform#4410/#4411; build reference
 * `hero-deck-8-cards-4410-2026-10-18.html`; v2.52 redrew cards 1, 7 and 8 from
 * `hero-deck-cards-v5-4410-2026-10-18.html`). Cards 5–8 are static markup and inline SVG drawn from the
 * page's one fixture (`site-fixture.mjs`, `hero-deck-svg.mjs`); the script and the CSS take any card
 * count, and `hero-deck.test.mjs` fails if the dots and the cards drift apart. No card names a plan or
 * a tier: each note is `section · <data kind>`.
 */
import OutlookBand from "./OutlookBand.astro";
import PortfolioCard from "./PortfolioCard.astro";
import PositionCard from "./PositionCard.astro";
import TechnicalsPriceChart from "./TechnicalsPriceChart.astro";
import MacroTile from "./MacroTile.astro";
import { coneSvg, earningsSvg, insidersSvg, skewSparkSvg } from "../charts/hero-deck-svg.mjs";
import {
  EARNINGS_AVERAGES,
  INSIDERS,
  INSIDER_FIGURES,
  INSIDER_ROWS,
  OPTIONS_CARD,
  TECHNICALS_ROWS,
} from "../charts/site-fixture.mjs";

const tech = Object.fromEntries(TECHNICALS_ROWS.map((r) => [r.label, r.value]));
const CARDS = [
  "Analysis",
  "Your Portfolio",
  "Your position",
  "Technicals & levels",
  "Options & short interest",
  "Earnings history",
  "Insiders",
  "Macro & regime",
];
---

<figure class="deck-fig">
  <div class="deck" id="deck" aria-roledescription="carousel" aria-label="Product views, changing every 5 seconds">
    <div role="group" aria-roledescription="slide" aria-label="Analysis" class="dcard dcard--outlook" data-key="outlook" data-pos="0">
      <OutlookBand deck />
    </div>
    <PortfolioCard variant="deck" />
    <PositionCard variant="deck" />
    <div role="group" aria-roledescription="slide" aria-label="Technicals & levels" class="dcard" data-key="technicals">
      <div class="dcard__hd"><span class="dcard__ttl">Technicals &amp; levels</span><span class="dcard__note">section · price data</span></div>
      <div class="dcard__fill"><TechnicalsPriceChart variant="hero" /></div>
      <div class="figs3">
        <div><span>50-DMA</span><b>{tech["50-DMA"]}</b></div>
        <div><span>RSI</span><b>{tech["RSI"]}</b></div>
        <div><span>52-week</span><b>{tech["52-week range"]}</b></div>
      </div>
    </div>
    <div role="group" aria-roledescription="slide" aria-label="Options & short interest" class="dcard dcard--cone" data-key="cone">
      <div class="dcard__hd"><span class="dcard__ttl">Options &amp; short interest</span><span class="dcard__note">section · options data</span></div>
      <div class="chartk">WHAT OPTIONS PRICE IN, TO THE END OF EACH HORIZON</div>
      <div class="dcard__fill"><Fragment set:html={coneSvg() + coneSvg({ phone: true })} /></div>
      <div class="figs3 figs3--rows">
        <div>
          <span>Skew</span>
          <b class="wrap">{OPTIONS_CARD.skew.word}</b>
          <em class="sk"><Fragment set:html={skewSparkSvg()} /><i>{OPTIONS_CARD.skew.volPoints.toFixed(1)} vol points</i></em>
        </div>
        <div><span>Put/call, volume</span><b>{OPTIONS_CARD.putCallVolume.toFixed(2)}</b></div>
        <div>
          <span>Short interest</span>
          <b>{OPTIONS_CARD.shortInterest.pct}</b>
          <em class="two"><i>of shares</i><i>settled {OPTIONS_CARD.shortInterest.settled}</i></em>
        </div>
      </div>
    </div>
    <div role="group" aria-roledescription="slide" aria-label="Earnings history" class="dcard" data-key="eh">
      <div class="dcard__hd"><span class="dcard__ttl">Earnings history</span><span class="dcard__note">section · earnings data</span></div>
      <div class="chartk">IMPLIED MOVE ▭ · ACTUAL MOVE ● · MOVED MORE ◯</div>
      <div class="dcard__fill"><Fragment set:html={earningsSvg() + earningsSvg({ phone: true })} /></div>
      <div class="figs3 figs3--rows">
        <div><span>Beat EPS estimate</span><b>{EARNINGS_AVERAGES.beat}</b></div>
        <div><span>Average move</span><b>{EARNINGS_AVERAGES.move}</b></div>
        <div><span>Average implied</span><b>{EARNINGS_AVERAGES.implied}</b></div>
      </div>
    </div>
    <div role="group" aria-roledescription="slide" aria-label="Insiders" class="dcard dcard--ins" data-key="insiders">
      <div class="dcard__hd"><span class="dcard__ttl">Insiders</span><span class="dcard__note">section · insider filings</span></div>
      <div class="hero-fig">
        <span class="hero-fig__k">Net, 6 months</span>
        <span class="hero-fig__v">Net selling <span class="nw">{INSIDER_FIGURES.net}</span></span>
        <span class="hero-fig__s">{INSIDER_FIGURES.counts}<span class="dk-only"> · officers and directors</span></span>
      </div>
      <div class="dcard__fill"><Fragment set:html={insidersSvg() + insidersSvg({ phone: true })} /></div>
      <div class="legend" aria-hidden="true">
        <span><i class="sw"></i>trade</span><span><i class="sw sw--plan"></i>10b5-1 plan trade</span><span class="dk-only">sells below the line · height is dollar value</span>
      </div>
      <div class="ib">
        <div class="ib-hd"><span>By insider</span><span>Traded</span><span>Of their shares</span></div>
        {INSIDER_ROWS.map((r) => (
          <div class="ib-row">
            <span class="ib-who">{r.title}</span>
            <span class="ib-amt">Sold ${r.usd.toFixed(1)}M</span>
            <span class="ib-pct"><i class="ib-bar" aria-hidden="true"><i style={`width:${r.pct}%`}></i></i>{r.pct}%</span>
          </div>
        ))}
      </div>
      <div class="figs3">
        <div><span>Under a 10b5-1 plan</span><b>{INSIDER_FIGURES.underPlan}</b><em>{INSIDERS.sellers} sellers · {INSIDERS.buyers} buyer</em></div>
        <div><span>Largest trade</span><b>−${INSIDER_FIGURES.largest.usd.toFixed(1)}M</b><em>{INSIDER_FIGURES.largest.title} · {INSIDER_FIGURES.largestDate}</em></div>
        <div class="dk-only"><span>Latest trade</span><b>{INSIDER_FIGURES.latestDate}</b><em>{INSIDER_FIGURES.latest.title}</em></div>
      </div>
    </div>
    <div role="group" aria-roledescription="slide" aria-label="Macro & regime" class="dcard dcard--macro" data-key="macro">
      <div class="dcard__hd"><span class="dcard__ttl">Macro &amp; regime</span><span class="dcard__note">section · macro data</span></div>
      {/* The product's Macro board (#4432/#4438), which replaced the risk-appetite gauge and the regime
          words (#4415): the two large rows, then two small ones. Each graph is drawn for the width it
          renders at (a 177px tile on a 413px card, 259px on a 283px phone card); below 400px of deck
          the small two drop so the large two stay legible. */}
      <div class="dcard__fill">
        <div class="mb mb--deck">
          <MacroTile row="vix" width={177} phoneWidth={259} />
          <MacroTile row="sp500" width={177} phoneWidth={259} />
          <MacroTile row="treasury-10y" width={177} class="dk-only" />
          <MacroTile row="inflation" width={177} class="dk-only" />
        </div>
      </div>
    </div>
  </div>
  <div class="deck-ctl" id="deckCtl" hidden>
    <button type="button" class="deck-pause" id="deckPause" aria-pressed="false">Pause</button>
    <div class="deck-dots">
      {CARDS.map((name, i) => <button type="button" class="deck-dot" data-i={i} aria-label={`Show ${name}`}></button>)}
    </div>
    <span class="deck-name" id="deckName" aria-live="polite"></span>
  </div>
  <figcaption class="proof__caption type-caption">Illustrative example with made-up figures and positions.</figcaption>
</figure>

<script src="/js/hero-deck.js" defer></script>
