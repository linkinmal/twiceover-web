---
// Mobile-app showcase (site-prelaunch.md §2 Home, v2.13 — new section, realizes
// stock-analyst-platform #2179). Static phone mockup only — no JS, CSS-only shimmer
// on the two "loading" skeleton rows. Per mobile-installed-app.md v1.1 masthead/
// cards/tabs anatomy. v3.4 (stock-analyst-platform#3829, build reference
// homepage-3818-v3-2026-09-23.html): the phone shows Your Portfolio, drawn from the same book
// (`PORTFOLIO`) as the hero deck and the Portfolio section, so the three cannot disagree.
import { PORTFOLIO, RULE_MARK, signedMoney } from "../charts/site-fixture.mjs";
---
{/* --recessed, not --lifted (stock-analyst-platform#3963 item 5 ruling, superseding the #3008
    ruling this comment used to cite — that ruling's own reasoning, about `doors` and
    `BeforeAfterRead`, is moot since both were retired in v3.4, #3829). The pricing strip directly
    above this section stays raised, so this seam needs its own ground to stay a seam. */}
<section class="mobile-showcase section-ground section-ground--recessed" aria-labelledby="mobile-showcase-heading">
  <div class="container mobile-showcase__inner">
    <div>
      <h2 id="mobile-showcase-heading" class="type-heading-1 section-heading">The same read, on your phone.</h2>
      <p class="mobile-showcase__sub">
        TwiceOver is coming to iPhone and Android, with Your Portfolio, your rules and the full analysis.
      </p>
      <span class="mobile-showcase__pill">iOS &amp; Android · coming soon</span>
    </div>

    <div class="phone" role="img" aria-label="TwiceOver on a phone, showing Your Portfolio with the Portfolio, Rules and Account tabs">
      <div class="phone__screen">
        <div class="phone__masthead">
          <span class="phone__mark" aria-hidden="true"><i></i><i></i></span>
          <span class="phone__word">TwiceOver</span>
        </div>
        <div class="phone__body">
          <p class="phone__halfbanner">Your Portfolio · {PORTFOLIO.broker} · synced {PORTFOLIO.syncedAt}</p>
          {PORTFOLIO.rows.map((r) => (
            <div class="phone__card">
              <p class="phone__card-title phone__card-title--small">
                <b>{r.ticker}</b> {r.structure} <span class={`phone__pl pc-pl ${r.pnl < 0 ? "dn" : "up"}`}>{signedMoney(r.pnl)}</span>
              </p>
              <p class="phone__rule"><i>{RULE_MARK[r.rule.state]}</i> {r.rule.text}</p>
            </div>
          ))}
        </div>
        <div class="phone__tabbar">
          <div class="phone__tab phone__tab--on">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 4h12M3 9h12M3 14h8" stroke="currentColor" stroke-width="1.5"/></svg>
            Portfolio
          </div>
          <div class="phone__tab">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M9 5.5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.5"/></svg>
            Rules
          </div>
          <div class="phone__tab">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="6.5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 15c1-3 3-4.5 5.5-4.5s4.5 1.5 5.5 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
            Account
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
