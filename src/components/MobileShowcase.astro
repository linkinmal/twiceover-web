---
// The homepage's phone section (app-launch-surfaces.md §2 S1, Main and Home-Mobile boards,
// stock-analyst-platform#4598; first built as site-prelaunch.md §2 v2.13, #2179). Heading and sub are
// the /app headline and sub, the same in every variant: the badges name the stores, so the words
// don't, and the book leads. Then the badges and, on a desktop, the QR; then three phones in the order
// a trader moves. Under 820px one phone (Portfolio) and no QR; the other two screens are on /app.
// The slot is unchanged: after the pricing strip, before the trust plate.
import Phone from "./Phone.astro";
import StoreBadges from "./StoreBadges.astro";
import AppQr from "./AppQr.astro";
import { APP_COPY, STORE_CAMPAIGNS } from "../app-launch.mjs";

const SCREENS = ["portfolio", "position", "analysis"] as const;
---
{/* --recessed, not --lifted (stock-analyst-platform#3963 item 5 ruling, superseding the #3008
    ruling this comment used to cite — that ruling's own reasoning, about `doors` and
    `BeforeAfterRead`, is moot since both were retired in v3.4, #3829). The pricing strip directly
    above this section stays raised, so this seam needs its own ground to stay a seam. */}
<section class="mobile-showcase section-ground section-ground--recessed" aria-labelledby="mobile-showcase-heading">
  <div class="container">
    <h2 id="mobile-showcase-heading" class="type-heading-1 section-heading">{APP_COPY.headline}</h2>
    <p class="mobile-showcase__sub">{APP_COPY.sub}</p>
    <div class="mobile-showcase__get">
      <StoreBadges campaign={STORE_CAMPAIGNS.home} />
      <AppQr line={APP_COPY.homeQr} hint={APP_COPY.homeQrHint} />
    </div>
    <div class="mobile-showcase__phones">
      {SCREENS.map((screen, i) => (
        <figure class:list={["mobile-showcase__phone", { "mobile-showcase__phone--wide": i > 0 }]}>
          <Phone screen={screen} />
          <figcaption>{APP_COPY.phoneCaptions[screen]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
