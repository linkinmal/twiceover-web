<div class="proof" aria-hidden="true">
  <svg class="proof__svg" viewBox="0 0 560 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A TwiceOver read for NVDA: positions and rules, the ticker analysis panel, and the Paths and Outlook container">
    {/*
