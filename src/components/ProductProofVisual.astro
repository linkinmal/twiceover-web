---
/**
 * The hero visual — the Outlook band carrying the product's real projection path chart
 * (stock-analyst-platform#2987, Option A, founder-approved 2026-08-30; site-prelaunch.md §2 Hero,
 * build reference `ai-team/design/assets/site-charts-hero-2026-08-30.html` §3).
 *
 * **What this replaces, and why.** The previous visual was a hand-drawn three-card composition: an
 * analysis sheet, a positions card, and a "Your Paths / Outlook" chip reading `near · mid · far` as
 * plain text. It NAMED the product's output without showing any of it. The headline already promises
 * "near-, mid- and far-term horizons"; this is the visual that states exactly that sentence, in the
 * real component, on the real geometry.
 *
 * The three cards' other content did not move here — the positions card, the rules rows and the
 * analysis sheet all already exist further down the page as real text (`BeforeAfterRead`,
 * `AnalysisMini`), which is where they belong and where they are selectable and translatable.
 *
 * **The last-close figure sits ABOVE the plot, not in it.** That is the signed artifact's placement,
 * reached after four in-plot attempts: on the dip shape the path descends into the label's own band
 * and the near dot lands on it. No vertical offset solves furniture placed in the data's own region.
 */
import OutlookPathChart from "./OutlookPathChart.astro";
import {
  AS_OF_CLOCK,
  HERO_OUTLOOK,
  HORIZON_CARDS,
  LAST_CLOSE_CAPTION,
  money,
} from "../charts/site-fixture.mjs";

const byKey = Object.fromEntries(HERO_OUTLOOK.horizons.map((h) => [h.horizon, h.price]));
---

<figure class="proof">
  {/* The accent surface, as a band — the same reserved Paths/Outlook treatment the app gives this
      object (ADR 0008), retoned to the app's bronze in this change. */}
  <div class="proof__band">
    <div class="proof__band-hd">
      <span class="proof__band-ttl">Outlook</span>
      <span class="proof__band-note">synthesis · conditional · as of {AS_OF_CLOCK}</span>
    </div>
    <p class="proof__chartcap">{LAST_CLOSE_CAPTION}</p>
    <OutlookPathChart />
    <div class="proof__hzrow">
      {HORIZON_CARDS.map((c) => (
        <div class="proof__hz">
          <div class="proof__hz-k">{c.label}</div>
          <div class="proof__hz-v">{money(byKey[c.key])}</div>
        </div>
      ))}
    </div>
  </div>
  {/* The entry-box's old caption (v2.6–v2.19) moved here, founder-directed 2026-08-22 —
      site-prelaunch.md §2/§6 v2.19 had it stay under the entry box; overridden per #2520's
      close. <figcaption> is the correct primitive for what this text has always actually
      been: a caption ON this visual (the fixed illustrative figures), not on the entry box
      above it. Carried across this change verbatim, per #2987. */}
  <figcaption class="proof__caption type-caption">Illustrative example — the same fixed AAPL/NVDA data shown throughout this page, not a live account.</figcaption>
</figure>
