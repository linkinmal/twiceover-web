---
// Per-section miniature fixture render used by AnalysisBand.astro's thirteen cards (homepage v3.4,
// stock-analyst-platform#3829; build reference ai-team/design/assets/homepage-3818-v3-2026-09-23.html).
// Keyed by the section's key in src/data/sections.mjs, the site's one section list.
// Illustrative-only figures, the same fixed NVDA fixture used throughout the page; every figure a
// card states is read from charts/site-fixture.mjs, never typed here, so the band cannot disagree
// with the hero deck or the Portfolio section beside it.
//
// PENDING stock-analyst-platform#3963 item 4: the five cards v3.4 adds (earnings, earnings-history,
// insiders, options, flow) each carry a small chart in the artifact. Their data is not yet in the
// fixture, so the cards state their figures in words and draw no chart until it is.
import {
  FUNDAMENTALS,
  HERO_OUTLOOK,
  HORIZON_CARDS,
  HORIZON_CONDITIONS,
  SECTION_FIGURES,
  TECHNICALS_ROWS,
  money,
} from "../charts/site-fixture.mjs";
import TechnicalsPriceChart from "./TechnicalsPriceChart.astro";

const projection = Object.fromEntries(
  HERO_OUTLOOK.horizons.map((h) => [h.horizon, money(h.price).replace(/\.00$/, "")]),
);
// The artifact's card states the four levels as a 2×2 grid with the 200-DMA among them.
const tech = Object.fromEntries(TECHNICALS_ROWS.map((r) => [r.label, r.value]));
const TECH_GRID = ["50-DMA", "200-DMA", "RSI", "52-week range"].map((label) => ({
  label: label === "52-week range" ? "52-week" : label,
  value: tech[label],
}));
const F = SECTION_FIGURES;

interface Props {
  kind: string;
}
const { kind } = Astro.props;
---
<div class={kind === "outlook" ? "band-mini band-mini--ok" : "band-mini"}>
  {kind === "fundamentals" && (
    <>
      <div class="kv-grid">
        <div><span class="kl">Revenue</span><span class="kv">{FUNDAMENTALS.revenue}</span></div>
        <div><span class="kl">EPS</span><span class="kv">{money(FUNDAMENTALS.eps)}</span></div>
        <div><span class="kl">Mkt cap</span><span class="kv">{FUNDAMENTALS.marketCap}</span></div>
      </div>
      <div class="row"><span>P/E, trailing 12 months</span><span class="v">{FUNDAMENTALS.peTrailing}</span></div>
    </>
  )}
  {kind === "earnings" && (
    <>
      <div class="row"><span>Implied move</span><span class="v">{F.earnings.impliedMove}</span></div>
      <p class="sub">{F.earnings.through}</p>
    </>
  )}
  {kind === "earnings-history" && (
    <>
      <div class="row"><span>Average move</span><span class="v">{F.earningsHistory.avgMove}</span></div>
      <div class="row"><span>Average implied</span><span class="v">{F.earningsHistory.avgImplied}</span></div>
    </>
  )}
  {kind === "insiders" && (
    <>
      <div class="row"><span>Net selling</span><span class="v">{F.insiders.netSelling}</span></div>
      <p class="sub">{F.insiders.plan}</p>
    </>
  )}
  {kind === "technicals" && (
    <>
      {/* The chart goes ABOVE the levels (#2992) — that reproduces the real section's composition
          rather than inventing a "mini". Its own compact state, never a shrunk desktop chart: this
          card is a fixed ~239px slot at every viewport. The grid reads from the SAME fixture object
          the chart's level candidates come from, so the two literally cannot disagree. */}
      <div class="band-mini__chart"><TechnicalsPriceChart variant="compact" /></div>
      <div class="kv-grid kv-grid--2">
        {TECH_GRID.map((r) => (
          <div><span class="kl">{r.label}</span><span class="kv">{r.value}</span></div>
        ))}
      </div>
    </>
  )}
  {kind === "options" && (
    <>
      <div class="row"><span>Short interest</span><span class="v">{F.options.shortInterest}</span></div>
      <p class="sub">{F.options.settled}</p>
    </>
  )}
  {kind === "flow" && (
    <>
      <div class="row"><span>Premium</span><span class="v">{F.flow.premium}</span></div>
      <p class="sub">{F.flow.window}</p>
    </>
  )}
  {kind === "sector" && (
    <>
      <p class="narr">Technology — sector strength increasing; valuation premium compressing.</p>
      <p class="sub">unit narrative · the sector, not the stock</p>
    </>
  )}
  {kind === "peers" && (
    <>
      <div class="chip-pair">
        <span>P/E 32.1 <em style="font-style:normal;color:var(--color-text-muted)">vs 28.5</em></span>
        <span>3M +8.2% <em style="font-style:normal;color:var(--color-text-muted)">vs +4.1%</em></span>
      </div>
      <div class="row"><span>MSFT</span><span class="v">P/E 28.3 · +5.2%</span></div>
      <p class="sub">open table · subject vs peer median</p>
    </>
  )}
  {kind === "news" && (
    <>
      <p class="narr"><strong>Earnings</strong> · Aug 27 — beats Q2 estimates <span class="sub">· Reuters</span></p>
      <p class="sub">why it matters: could signal AI demand continuing</p>
      <div class="row"><span>Next monthly expiry</span><span class="v">Sep 18</span></div>
    </>
  )}
  {kind === "voices" && (
    <>
      <p class="sub">via X</p>
      <p class="narr"><span class="handle">@handle</span><span class="sub"> · Aug 13 — </span>constructive on the AI chip cycle into year-end; capacity, not demand, is the constraint. <span class="src">X ↗</span></p>
      <p class="sub">Each post named and linked in a real analysis.</p>
    </>
  )}
  {kind === "macro" && (
    <>
      <div class="row"><span>Tactical</span><span class="v">Fed on hold</span></div>
      <div class="row"><span>Strategic</span><span class="v">Soft landing</span></div>
      {/* The product's real `.macro-risk-axis` anatomy, not an invented bar-and-dot (#2995,
          site-prelaunch.md v2.32 §2; build reference site-charts-hero-2026-08-30.html §8).
          Hairline rule, three ticks with the zero tick full-height and heavier, a 2px marker, the
          net value above the marker, and the product's own Cautious/Supportive bounds — never the
          words "defensive / Balanced / risk-on", which the product does not use.

          net +0.35 → (0.35 + 1) / 2 = 67.5%, the artifact's own figure and position. The two are
          derived from one number in the real component; kept in step here by construction. */}
      <div class="mra">
        <span class="mra__num" style="left:67.5%">+0.35</span>
        <div class="mra__rail" aria-hidden="true">
          <span class="mra__line"></span>
          <span class="mra__tick mra__tick--min" style="left:0%"></span>
          <span class="mra__tick mra__tick--zero" style="left:50%"></span>
          <span class="mra__tick mra__tick--max" style="left:100%"></span>
          <span class="mra__mark" style="left:67.5%"></span>
        </div>
        <div class="mra__scale">
          <span><span class="mra__bound">−1.00</span> <b>Cautious</b></span>
          <span class="mra__bound">0</span>
          <span><b>Supportive</b> <span class="mra__bound">+1.00</span></span>
        </div>
      </div>
    </>
  )}
  {kind === "outlook" && (
    <>
      {HORIZON_CARDS.map((c) => (
        <div class="okh">
          <div class="okh__r"><b>{c.label}</b><span class="proj-v">{projection[c.key]}</span></div>
          <i>{HORIZON_CONDITIONS[c.key]}</i>
        </div>
      ))}
      <p class="sub">Our projection, not a guarantee — you decide.</p>
    </>
  )}
</div>
