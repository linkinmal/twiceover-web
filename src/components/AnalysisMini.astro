---
// One band card's miniature, drawn from blocks (homepage v3.4, stock-analyst-platform#3829; the
// explainer's page 1, ADR 0993). The homepage feeds it the NVDA cards (`BAND_CARDS`,
// charts/site-fixture.mjs); "How our analysis works" feeds it the EXMP cards (`EXMP_BAND_CARDS`,
// charts/exmp-fixture.mjs) — "the homepage band's own card renderers, fed EXMP figures" (ADR 0993),
// so the two pages draw each section the same way. Every figure is the fixture's; nothing is typed here.
//
// Block vocabulary: kv / kv2 (label-over-value grid), row (label · value), sub, narr, chips (subject vs
// median), news, post, macroTiles (Macro board tiles), okh (the Outlook's three horizons), outlookChart (EXMP's month and projection path), chart.
import TechnicalsPriceChart from "./TechnicalsPriceChart.astro";
import OutlookPathChart from "./OutlookPathChart.astro";
import MacroTile from "./MacroTile.astro";
import { EXMP_OUTLOOK_CHART } from "../charts/exmp-fixture.mjs";
import { BAND_CARDS } from "../charts/site-fixture.mjs";

interface Props {
  kind: string;
  cards?: Record<string, Array<Record<string, any>>>;
  // The Macro tiles' graph width where this card renders, and a phone twin (MacroTile), so the chart
  // type draws at true size rather than scaled with the card (Designer gate, twiceover-web PR 165).
  macroWidth?: number;
  macroPhoneWidth?: number;
}
const { kind, cards = BAND_CARDS, macroWidth = 184, macroPhoneWidth } = Astro.props;
const blocks = cards[kind];
---
<div class={kind === "outlook" ? "band-mini band-mini--ok" : "band-mini"}>
  {blocks.map((b) => (
    <>
      {b.chart === "technicals" && (
        /* Its own compact state, never a shrunk desktop chart: this card is a fixed ~239px slot. */
        <div class="band-mini__chart"><TechnicalsPriceChart variant="compact" /></div>
      )}
      {b.outlookChart && (
        /* The Outlook's own compact state in a fixed slot, like the Technicals card above it. */
        <div class="band-mini__chart"><OutlookPathChart {...EXMP_OUTLOOK_CHART} /></div>
      )}
      {b.kv && (
        <div class="kv-grid">
          {b.kv.map(([l, v]) => <div><span class="kl">{l}</span><span class="kv">{v}</span></div>)}
        </div>
      )}
      {b.kv2 && (
        <div class="kv-grid kv-grid--2">
          {b.kv2.map(([l, v]) => <div><span class="kl">{l}</span><span class="kv">{v}</span></div>)}
        </div>
      )}
      {b.row && <div class="row"><span>{b.row[0]}</span><span class="v">{b.row[1]}</span></div>}
      {b.sub && <p class="sub">{b.sub}</p>}
      {b.narr && <p class="narr">{b.narr}</p>}
      {b.chips && (
        <div class="chip-pair">
          {b.chips.map(([subject, median]) => <span>{subject} <em>{median}</em></span>)}
        </div>
      )}
      {b.news && (
        <p class="narr narr--news"><strong>{b.news[0]}</strong> · {b.news[1]} — {b.news[2]} <span class="sub">· {b.news[3]}</span></p>
      )}
      {b.post && (
        /* Date first, as the product's own Voices row reads (read-components §8a; site-prelaunch v2.54). */
        <p class="narr narr--post"><span class="sub">{b.post[0]} · </span><span class="handle">@handle</span><span class="sub"> — </span>{b.post[1].charAt(0).toUpperCase() + b.post[1].slice(1)} <span class="src">X ↗</span></p>
      )}
      {b.macroTiles && (
        /* Two of the product's Macro board tiles (stock-analyst-platform#4432/#4438), which replaced
           the risk-appetite gauge (#4415). The graph is drawn for the band card's ~208px inner width
           unless the caller names the width it renders at. */
        <div class="mb mb--mini">
          {b.macroTiles.map((row) => <MacroTile row={row} width={macroWidth} phoneWidth={macroPhoneWidth} range={false} />)}
        </div>
      )}
      {b.okh && b.okh.map(([label, value, cond]) => (
        <div class="okh">
          <div class="okh__r"><b>{label}</b><span class="proj-v">{value}</span></div>
          {cond && <i>{cond}</i>}
        </div>
      ))}
    </>
  ))}
</div>
