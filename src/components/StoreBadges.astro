---
// The store badges (app-launch-surfaces.md §2 "Badges" and "Variants", Badges board): official artwork,
// unaltered, Apple's first and black, Play's the same height, 44px. Each badge keeps a quarter of its
// height (11px) clear on every side, and two badges sit two clear zones apart (site.css). One variant per build (`APP_STORES`); a lone badge carries the plain line naming the other.
// Each badge carries BADGE_MARKER, which the Terms credit check reads (stock-analyst-platform#4597).
import { APP_STORES, BADGE_ART, STORE_CAMPAIGNS, appStoreUrl, assertBadgeArt, playStoreUrl, storesFor } from "../app-launch.mjs";

// `campaign` names the placement in the store's install counts (app-stores.md §3): /app by default, the homepage band passes `site-home`.
const { campaign = STORE_CAMPAIGNS.appPage } = Astro.props;
assertBadgeArt(APP_STORES);
const { apple, play, comingSoon } = storesFor(APP_STORES);
---
<div class="store-badges">
  <div class="store-badges__row">
    {apple && (
      <a class="store-badge" href={appStoreUrl(campaign)} data-store-badge="apple">
        <img src={BADGE_ART.apple} alt="Download on the App Store" height="44" />
      </a>
    )}
    {play && (
      <a class="store-badge" href={playStoreUrl(campaign)} data-store-badge="play">
        <img src={BADGE_ART.play} alt="Get it on Google Play" height="44" />
      </a>
    )}
  </div>
  {comingSoon && <p class="store-badges__next">{comingSoon}</p>}
</div>
