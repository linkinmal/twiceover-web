---
// The "second look" mark (canonical asset: stock-analyst-platform
// /ai-team/design/assets/twiceover-mark.svg). Inline embed swaps fills to
// currentColor per visual-identity.md; bar 2 keeps the structural 0.55 opacity —
// never render both bars at full strength. aria-hidden: the wordmark text beside
// it carries the name.
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true" style="color: var(--color-accent-default)">
  <rect x="5" y="11" width="22" height="3.4" rx="1.7" fill="currentColor"/>
  <rect x="10" y="18" width="17" height="3.4" rx="1.7" fill="currentColor" opacity="0.55"/>
</svg>
