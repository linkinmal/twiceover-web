---
// Pricing (site-prelaunch.md §3) — copy verbatim from "Page: Pricing" (#41).
// Figures are placeholders until #41 finalizes; no annual prices landed, so the
// designed billing toggle does NOT ship (monthly-only, zero JS — design open
// question resolved per spec). No card CTA in #39 — no checkout exists yet.
// Tier symmetry is a compliance feature (spec §6.2): never differentiate cards.
import Base from "../layouts/Base.astro";
import { MOR_NAME } from "../config.mjs";
---
<Base
  title="Pricing — TwiceOver"
  description="Simple subscription. One price, billed monthly or annually. No per-analysis charges."
>
  <div class="page-title-block">
    <h1 class="type-heading-1">Simple subscription. You hold the decisions; we do the math.</h1>
    <p class="sub">One price, billed monthly or annually. No per-analysis charges.</p>
  </div>

  <ul class="tier-grid">
    <li class="tier">
      <h2 class="type-heading-2">Core</h2>
      <p class="price type-display">~$49<span class="per">/mo</span></p>
      <p class="price-note">(or annual, discounted)</p>
      <ul>
        <li>Read-only broker connection</li>
        <li>Held-position reads and new-idea reads</li>
        <li>Options math &amp; structure engine (breakevens, max profit/loss, collateral, P&amp;L)</li>
        <li>Your own rules, evaluated on live data</li>
        <li>Macro/regime context and the research layer</li>
        <li>Market data on a standard tier</li>
      </ul>
    </li>
    <li class="tier">
      <h2 class="type-heading-2">Premium</h2>
      <p class="price type-display">~$99<span class="per">/mo</span></p>
      <p class="price-note">(or annual, discounted)</p>
      <ul>
        <li>Everything in Core</li>
        <li>Real-time market-data tier</li>
        <li>Deeper flow and curated-voice signal</li>
        <li>Higher usage limits</li>
      </ul>
    </li>
  </ul>

  <p class="mor-line">Subscriptions are billed by <strong>{MOR_NAME}</strong> as the merchant of record; prices in USD. You can cancel anytime; see the <a href="/refunds">Refund Policy</a>.</p>
</Base>
