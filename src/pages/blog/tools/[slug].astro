---
// A tool page: /blog/tools/<slug> (blog-handoff.md section 1). Built like a game page: a standing page in a theme,
// with its primer folded, the answer beside the inputs, and the method and limits stated. It exists only once a
// post is published (ADR 1090 Decision 2), and its one block script is on the fixed list (BLOG_SCRIPTS).
import BlogBase from "../../../layouts/BlogBase.astro";
import PayoffBuilder from "../../../components/blog/PayoffBuilder.astro";
import OvernightCall from "../../../components/blog/OvernightCall.astro";
import { getPublished } from "../../../blog/collection.mjs";
import { PLAYABLES, otherPlayables } from "../../../blog/playables.mjs";
import { LOOKS } from "../../../blog/vocabulary.mjs";
import { TOPIC_LABELS } from "../../../blog/labels.mjs";
import { formatStamp, toNewYorkIso } from "../../../blog/format.mjs";

export async function getStaticPaths() {
  if ((await getPublished()).length === 0) return [];
  return PLAYABLES.filter((p) => p.kind === "tool").map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const look = LOOKS[p.look as keyof typeof LOOKS];
const more = otherPlayables(p.slug);
---
<BlogBase title={`${p.title} — TwiceOver`} description={p.description} preload={[look.display]}>
  <nav slot="meta" class="meta" aria-label="This page">
    <a href={p.path}>Tool</a>
    <a href={`/blog/topic/${p.topic}`}>{TOPIC_LABELS[p.topic as keyof typeof TOPIC_LABELS]}</a>
    <span>Updated <time datetime={toNewYorkIso(p.updatedAt)}>{formatStamp(p.updatedAt)}</time></span>
  </nav>
  <article class="post skin" data-look={look.kit}>
    <div class="col">
      <p class="lab">Tool</p>
      <h1 class="h1">{p.title}</h1>
      <p class="deck">{p.deck}</p>
      {p.slug === "overnight-call" && (
        <>
          <p class="words">A <b>call</b> is a contract that lets you pay a set price per share for 100 shares, any time until a set date. The contract itself has a price, called the premium. It is worth more when the stock is higher. The set price is the <b>strike</b>. The set date is the <b>expiration</b>. <b>Implied volatility</b> is how big a stock move the call's price has built in, quoted as a yearly percentage.</p>
          <OvernightCall />
          <section class="blk plate">
            <p class="lab">How it is computed</p>
            <p class="fine"><b>Method.</b> Black-Scholes price of a European call, with no interest rate and no dividend. Volatility is annualized and days are calendar days over 365. The change is split in order: the stock moves first, then volatility changes, then the days pass. The one-day priced move is implied volatility divided by the square root of 365.</p>
            <p class="fine"><b>Limits.</b> Real options are American style, carry bid and ask spreads and rarely change volatility by one number. Results change with every input and with the market. This is a hypothetical illustration of option pricing math. It does not predict any stock or option.</p>
          </section>
        </>
      )}
      {p.slug === "option-payoff-calculator" && (
        <>
          <p class="words">A <b>call</b> is a contract that lets you pay a set price per share for 100 shares, any time until a set date. A <b>put</b> lets you be paid that set price for them instead. The set price is the <b>strike</b>. The set date is the <b>expiration</b>, the contract's last day. The contract itself has a price, called the <b>premium</b>, quoted per share. One contract covers 100 shares, so a $2.46 premium is $246 a contract.</p>
          <PayoffBuilder />
          <section class="blk plate">
            <p class="lab">How it is computed</p>
            <p class="fine"><b>Method.</b> Each option's value on its last day is its intrinsic value: a call is the stock price minus the strike, a put is the strike minus the stock price, never below zero. Subtract the premium for an option you bought, add it for one you sold. The line is the sum, times 100 shares a contract and the number of contracts. A covered call also holds the shares, bought at the stock price now.</p>
            <p class="fine"><b>Limits.</b> The line is the last day only. Before then an option is worth more or less than this because of time left and implied volatility, and a short option can be assigned early. Commissions, taxes, dividends and margin are left out. The numbers are invented examples and are not a quote. This is a hypothetical illustration of option math. It does not predict any stock or option.</p>
          </section>
        </>
      )}
    </div>
  </article>
  <div class="page">
    {more.length > 0 && (
      <>
        <p class="xh">More to play</p>
        <nav class="pnav" aria-label="More to play">
          {more.map((m) => <a href={m.path}>{m.kind === "game" ? "Game" : "Tool"}<b>{m.label}</b></a>)}
        </nav>
      </>
    )}
  </div>
  <script is:inline src={`/js/blog-${p.script}.js`} defer></script>
</BlogBase>
