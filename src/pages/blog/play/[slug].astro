---
// A game page: /blog/play/<slug> (blog-handoff.md section 1). The route knows no page: it renders whichever
// src/playables/<slug>/page.astro the loader finds by folder inside the shared frame (ADR 1127 Decision 2).
import PlayableShell from "../../../components/blog/PlayableShell.astro";
import { getPublished } from "../../../blog/collection.mjs";
import { PLAYABLES, pageOf } from "../../../blog/playables.mjs";

// With no published post there is no blog at all, and a game page would be a blog page: it waits with the first
// post (ADR 1090 Decision 2: a build with nothing published emits no /blog, feed or sitemap entry).
export async function getStaticPaths() {
  if ((await getPublished()).length === 0) return [];
  return PLAYABLES.filter((p) => p.kind === "game").map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const Page = await pageOf(p.slug);
---
<PlayableShell p={p}><Page /></PlayableShell>
