---
// A game page: /blog/play/<slug> (blog-handoff.md section 1). A standing page: it wears a theme like a post, has no
// punchline headline and no date of its own beyond "Updated", and links its sibling playables. The block
// script is a reviewed file on the fixed list (ADR 1088 Decision 1; BLOG_SCRIPTS in ci/content-rules.mjs).
import BlogBase from "../../../layouts/BlogBase.astro";
import CoinGame from "../../../components/blog/CoinGame.astro";
import { getPublished } from "../../../blog/collection.mjs";
import { PLAYABLES, otherPlayables } from "../../../blog/playables.mjs";
import { LOOKS } from "../../../blog/vocabulary.mjs";
import { TOPIC_LABELS } from "../../../blog/labels.mjs";
import { formatStamp, toNewYorkIso } from "../../../blog/format.mjs";

// With no published post there is no blog at all, and a game page would be a blog page: it waits with the first
// post (ADR 1090 Decision 2: a build with nothing published emits no /blog, feed or sitemap entry).
export async function getStaticPaths() {
  if ((await getPublished()).length === 0) return [];
  return PLAYABLES.filter((p) => p.kind === "game").map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const look = LOOKS[p.look as keyof typeof LOOKS];
const more = otherPlayables(p.slug);
---
<BlogBase title={`${p.title} — TwiceOver`} description={p.description} preload={[look.display]}>
  <nav slot="meta" class="meta" aria-label="This page">
    <a href={p.path}>Playable</a>
    <span>Game</span>
    <a href={`/blog/topic/${p.topic}`}>{TOPIC_LABELS[p.topic as keyof typeof TOPIC_LABELS]}</a>
    <span>Updated <time datetime={toNewYorkIso(p.updatedAt)}>{formatStamp(p.updatedAt)}</time></span>
  </nav>
  <article class="post skin" data-look={look.kit}>
    <div class="col">
      <p class="lab">Game</p>
      <h1 class="h1">{p.title}</h1>
      <p class="deck">{p.deck}</p>
      <section class="blk"><CoinGame /></section>
      <section class="blk">
        <p class="lab">How it is played</p>
        <p>Each flip bets a share of what you hold. Heads adds the bet. Tails takes it. You can change the share between flips.</p>
        <p>A game is up to 300 flips. It stops early at the $250 cap. Under $2 counts as bust.</p>
        <p>Your own game is new every time. The bars come from 2,000 games per bet size with a fixed seed, so every visit shows the same bars.</p>
        <p>Nothing you do here is sent anywhere or stored. The tally of your games lasts until you leave the page.</p>
        <p class="stamp"><span><b>Source</b> computed on this page, a fair 60% coin</span></p>
      </section>
    </div>
  </article>
  <div class="page">
    {more.length > 0 && (
      <>
        <p class="xh">More to play</p>
        <nav class="pnav" aria-label="More to play">
          {more.map((m) => <a href={m.path}>{m.kind === "game" ? "Game" : "Tool"}<b>{m.label}</b></a>)}
        </nav>
      </>
    )}
  </div>
  <script is:inline src="/js/blog-coin.js" defer></script>
</BlogBase>
