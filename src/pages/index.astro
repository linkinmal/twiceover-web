---
// Home — homepage v3.4 (stock-analyst-platform#3829; ADR 0991 signed the build reference
// ai-team/design/assets/homepage-3818-v3-2026-09-23.html; section order and copy tables are
// consult 0987's, with the PM's #3935 accuracy corrections folded into the artifact). Every string
// on this page is the artifact's, pinned by homepage-copy.test.mjs and faq-structure.test.mjs.
//
// Sections, in consult 0987 §1's order (kept by the founder): hero with its product deck → the
// analysis band → how the sections become the Outlook → Your Portfolio → broker connection →
// facts strip → pricing strip → mobile → trust plate → FAQ → what it is not → closing band.
//
// The "Connect read-only →" CTA and header sign-in slot are same-origin /go/* redirects (#1754,
// site-app-seam.md §3/§4); see Base.astro for the header slot.
import Base from "../layouts/Base.astro";
import AnalysisBand from "../components/AnalysisBand.astro";
import MobileShowcase from "../components/MobileShowcase.astro";
import HeroDeck from "../components/HeroDeck.astro";
import OutlookBand from "../components/OutlookBand.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import PositionCard from "../components/PositionCard.astro";
import { SECTIONS, sectionsOn, sectionCountLine } from "../data/sections.mjs";

// Organization + WebSite JSON-LD (SEO audit 2026-07 finding 7) — brand-SERP/knowledge-panel
// groundwork. No FAQPage schema: Google deprecated FAQ rich results 2026-05-07.
// sameAs/logo (SEO re-audit 2026-08-23, stock-analyst-platform#2634): the X account didn't exist in
// July, does now — sameAs links the two brand surfaces for knowledge-panel eligibility and AI-answer
// entity resolution. logo points at the existing square PWA icon (already served, no new asset).
// YouTube added (stock-analyst-platform#3606): the channel went live 2026-09-14.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TwiceOver",
  url: "https://twiceover.io",
  email: "support@twiceover.io",
  sameAs: ["https://x.com/twiceover_io", "https://www.youtube.com/@twiceover-io"],
  logo: "https://twiceover.io/icon-192.png",
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TwiceOver",
  url: "https://twiceover.io",
};

// The synthesis block's chips: every section the Outlook weighs, which is every section but itself.
const chips = SECTIONS.filter((s) => s.key !== "outlook");
// Decorative lines converging on the Outlook — one per chip column, evenly spaced across the viewBox.
const CONVERGE = Array.from({ length: 11 }, (_, i) => 20 + i * 56);
---
<Base
  title="TwiceOver — a second look at your own book"
  description="See every position you hold, read-only, with its full math and your own rules checked. Analyze any US-listed ticker, down to a projected price per horizon."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  {/* Hero — the connect CTA is the FILLED button now (v3.4), with the ticker box as the second
      door beneath it. The deck on the right is the product itself, card by card. */}
  <section class="hero">
    <div class="hero__copy">
      <h1 class="type-display">A second look at your own book.</h1>
      <p class="sub">Every position in your brokerage account, checked against the rules you set.</p>
      <a class="btn-filled hero__cta" href="/go/connect">Connect read-only →</a>
      <p class="demo-turn">Or analyze any US-listed ticker, down to a projected price for each horizon. No account needed.</p>
      {/* The live ticker handoff (#2520, ADR 0383 Amendment 1, consult 0739) — replaces the
          v2.6 fixture-only demo. A plain HTML GET submit: the browser serializes `ticker` and
          navigates same-origin to /go/try, whose Worker bounds the value to /^[A-Z]{1,6}$/ and
          302s to the app. ("no JavaScript anywhere" struck — the typeahead below is JavaScript
          on this page; the SUBMIT is still a plain GET the browser performs, and the form works
          unchanged with the script absent.) Three attributes are pinned exactly and
          enforced by ci/check-entry-box.mjs — name="ticker", method="get", action="/go/try";
          `method` is never `post` (a body travels off-URL) and `action` is never external.
          The app prefills and focuses its own box but NEVER auto-submits: the second press is
          the assent act, covered by the app-side notice on direct/bare-URL app arrivals
          (ADR 0442 Amendment 1 R5) — this page no longer carries its own notice (ADR 0442
          Amendment 3, stock-analyst-platform#2960: founder call, site-side leg retired).
          CORRECTED (ADR 0810 build order item 6, stock-analyst-platform#2965): this page used to
          state "Deliberately absent: any script reading .value, and any fetch/XHR/WebSocket/
          sendBeacon on this page." Half of that is no longer true and the sentence does not
          survive the mechanism changing. What holds now:
            - a script DOES read this field's value, on every keystroke — the ticker/company-name
              typeahead (src/typeahead/, R1–R8 of read-components.md §6), signed off as a carve-out
              (ADR 0810) and reviewed by Security (consult 0811). It ships as a bundle under
              /_astro/, never inline: an inline script reading a field remains barred outright by
              ci/check-entry-box.mjs, and the Worker's script-src 'self' admits no inline exception.
            - the transmission ban is UNCHANGED and now enforced twice. No script on this page opens
              a connection of any kind; ci/check-entry-box.mjs scans every bundled body for the
              barred calls at build time, and the Worker's Content-Security-Policy `connect-src
              'none'` backstops it in the browser at runtime.
          The typeahead consults a committed, EDGAR-derived symbol index bundled with the site and
          nothing else — it never speaks to a server, and selecting a suggestion fills the field
          but NEVER submits (R6). The press below stays the one and only assent act. With the
          script absent or failed, this form is exactly the plain HTML GET it always was. */}
      <form class="entry-box" id="entry-form" action="/go/try" method="get" novalidate>
        <label class="visually-hidden" for="entry-ticker">A ticker</label>
        {/* The wrapper is what the listbox anchors to (position: relative in site.css), and it
            carries the input's flex sizing so the row's geometry is unchanged. */}
        <div class="symbol-combobox entry-box__field-wrap">
          <input id="entry-ticker" name="ticker" type="text" autocomplete="off" spellcheck="false" placeholder="Type a ticker — NVDA" />
        </div>
        <button type="submit" class="entry-box__submit">Analyze</button>
      </form>
    </div>
    <HeroDeck />
  </section>

  {/* Analysis band — the thirteen sections, from the site's one section list. */}
  <AnalysisBand />

  {/* How the sections become the Outlook (consult 0987 §1). The chips are the band's sections
      less the Outlook itself, read from the same list; the Outlook below them is the SAME band as
      the hero deck's first card, not a second drawing of it. */}
  <section class="synth section-ground" aria-labelledby="synth-h">
    <div class="container synth__inner">
      <div class="synth__copy">
        <h2 id="synth-h" class="type-heading-1 section-heading">How the sections become three projected prices.</h2>
        <p class="synth__p">The Outlook is our AI synthesis. It weighs every section your plan shows you and projects where the price lands in about two weeks, three months and six months. Each price comes with the reason behind it and what would prove it wrong. Every reason draws on the sections your plan includes.</p>
      </div>
      <div class="synth__viz">
        <div class="chips">{chips.map((s) => <span>{s.short}</span>)}</div>
        <svg class="converge" viewBox="0 0 600 46" preserveAspectRatio="none" aria-hidden="true">
          {CONVERGE.map((x) => <path d={`M${x} 0 C ${x} 26, 300 20, 300 44`} />)}
        </svg>
        <div class="synth__outlook"><OutlookBand /></div>
        <p class="proof__caption type-caption">Illustrative example with made-up figures.</p>
      </div>
    </div>
  </section>

  {/* Your Portfolio (consult 0987 §1) — the list and one opened position, from the same book as
      the hero deck and the phone. */}
  <section class="pv section-ground section-ground--lifted" aria-labelledby="pv-h">
    <div class="container">
      <h2 id="pv-h" class="type-heading-1 section-heading">Your book, checked against your own rules.</h2>
      <p class="pv__p">Connect read-only and Your Portfolio lists everything you hold. Positions that have hit one of your rules come first: a profit target, a max loss or an expiry line you set. Open a position to see its breakevens and where each rule stands on current prices. For an options structure, scenarios show it at other prices. Paths show what you could do next, from making no change to rolling, each with its math.</p>
      <div class="pv__grid">
        <PortfolioCard variant="section" />
        <PositionCard variant="section" />
      </div>
      <p class="proof__caption type-caption">Illustrative example with made-up positions.</p>
    </div>
  </section>

  {/* Broker connection (#2208; v3.4 copy, consult 0987). */}
  <section class="connect" aria-labelledby="connect-heading">
    <div class="container">
      <h2 id="connect-heading" class="connect__head">Connect with the broker login you already have.</h2>
      <p class="connect__body">Interactive Brokers, Schwab, Fidelity, Robinhood, E*Trade, tastytrade, Webull, Vanguard and more connect read-only, and TwiceOver never touches your funds.</p>
      <p class="connect__disclosure type-caption">Connections run through SnapTrade (SOC 2 Type II) and are authorized by your broker. You sign in through SnapTrade or your broker, and TwiceOver never sees your credentials.</p>
    </div>
  </section>

  {/* Facts strip — structural facts about the product's construction, never a performance claim.
      The section count and its per-plan line are composed from the section list, never typed. */}
  <section class="depth-strip" aria-label="TwiceOver at a glance">
    <div class="container depth-strip__inner">
      <div class="depth-stat">
        <p class="depth-stat__figure type-display">{sectionsOn("premium").length}</p>
        <p class="depth-stat__caption">{sectionCountLine()}</p>
      </div>
      <div class="depth-stat">
        <p class="depth-stat__figure type-display">4</p>
        <p class="depth-stat__caption">Paths for every options structure you hold: make no change, close, reduce or roll. Each comes with its math.</p>
      </div>
      <div class="depth-stat">
        <p class="depth-stat__figure type-display">3</p>
        <p class="depth-stat__caption">Horizons in every Outlook: about two weeks, three months and six months out. Each gets one projected price and the reason for it.</p>
      </div>
      <div class="depth-stat">
        <p class="depth-stat__figure type-display">Read-only</p>
        <p class="depth-stat__caption">TwiceOver can see your positions. It can never place, change or cancel an order.</p>
      </div>
    </div>
  </section>

  {/* Pricing strip (#2812; three plans in v3.4). The Free and Core cap lines are QUOTATIONS of
      the live /pricing cards, asserted equal by pricing-strip-and-closing-band.test.mjs so a reword
      on either page fails the build. PENDING stock-analyst-platform#3962: /pricing gains its
      Premium card there, and the Premium line joins that quotation check when it does. */}
  <section class="pricing-strip section-ground section-ground--lifted" aria-label="Pricing at a glance">
    <div class="pricing-strip__grid">
      <div class="pricing-stat">
        <p class="pricing-stat__label">Free</p>
        <p class="pricing-stat__figure type-display">$0</p>
        <p class="pricing-stat__caption">10 analyses a month</p>
        <p class="pricing-stat__more">Your Portfolio in full. The Outlook, built on fundamentals, technicals, peers, the sector and macro.</p>      </div>
      <div class="pricing-stat">
        <p class="pricing-stat__label">Core</p>
        <p class="pricing-stat__figure type-display">$49<span class="per">/mo</span></p>
        <p class="pricing-stat__caption">200 analyses a month</p>
        <p class="pricing-stat__more">Everything in Free, plus: news and market voices, earnings and dividends, what options price in, and short interest.</p>
      </div>
      <div class="pricing-stat">
        <p class="pricing-stat__label">Premium</p>
        <p class="pricing-stat__figure type-display">$99<span class="per">/mo</span></p>
        <p class="pricing-stat__caption">300 analyses a month</p>
        <p class="pricing-stat__more">Everything in Core, plus: the largest options trades, earnings history against the implied move, and insider buying and selling.</p>      </div>
    </div>
    <a class="btn-quiet pricing-strip__link" href="/pricing">See full pricing →</a>
  </section>

  <MobileShowcase />

  {/* Trust plate (the one deliberate register break, dark-variant Ledger tokens, ADR 0035). */}
  <section class="trust-plate" data-theme="dark" aria-labelledby="trust-plate">
    <div class="container">
      <h2 id="trust-plate" class="type-heading-1 section-heading">Built the honest way</h2>
      <div class="trust-grid">
        <div class="trust-card">
          <svg class="trust-card__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="11" width="12" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <h3 class="type-heading-2">Read-only, structurally</h3>
          <p>Your brokerage connection can view your positions and is technically incapable of placing, changing or canceling an order.</p>
        </div>
        <div class="trust-card">
          <svg class="trust-card__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5"/></svg>
          <h3 class="type-heading-2">Licensed data only</h3>
          <p>Every quote and news item comes from a licensed vendor. None of it is scraped.</p>
        </div>
        <div class="trust-card">
          <svg class="trust-card__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <h3 class="type-heading-2">Your book stays yours</h3>
          <p>Your positions and account data are never shown to or reused for another user.</p>
        </div>
        <div class="trust-card">
          <svg class="trust-card__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <h3 class="type-heading-2">Every number stamped</h3>
          <p>Every figure in a section carries its source and the time it was fetched. The Outlook's prices are labelled as our projection.</p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ — native details/summary accordion, no JS. Fifteen items in two labeled groups; the two
      Outlook questions join after the first (consult 0987 §2). Only the very first item starts open. */}
  <section class="faq section-ground section-ground--lifted" aria-labelledby="faq-heading">
    <div class="faq__intro">
      <p class="type-caption faq__kicker">FAQ</p>
      <h2 id="faq-heading" class="type-heading-1">Questions, answered plainly</h2>
      <p>The same plain-language answers we'd give if you asked us directly.</p>
    </div>
    <div class="faq__list">
      <h3 class="type-caption faq__group-label">Before you sign up</h3>
      <details open>
        <summary class="type-heading-2">What is TwiceOver, exactly?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>TwiceOver has two parts. Your Portfolio shows the positions you hold, read-only from your broker, with their math and your own rules checked on current prices. Our analysis is our view of any US-listed ticker, the same for every reader on the same plan. TwiceOver is a decision-support tool. It is not a registered investment adviser or broker-dealer, and it never tells you to buy or sell.</p>
      </details>
      <details>
        <summary class="type-heading-2">How is the Outlook different from a price target?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>An analyst's price target is usually one number, a year out. The Outlook gives three projected prices, about two weeks, three months and six months out, each with its reasoning and what would prove it wrong. The Outlook shows the sections it weighed.</p>
      </details>
      <details>
        <summary class="type-heading-2">Does every plan get the same Outlook?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Each plan's Outlook weighs only the sections that plan shows, so every price rests on evidence you can read. Core and Premium give the Outlook more to weigh, so their projections for the same ticker can differ from Free's.</p>
      </details>
      <details>
        <summary class="type-heading-2">Can TwiceOver trade on my behalf?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>No. The connection is read-only. TwiceOver can see your positions but cannot place, change or cancel an order, and it never touches your funds.</p>
      </details>
      <details>
        <summary class="type-heading-2">Where does the data come from?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Quotes, options and news data come from licensed vendors. Insider trades come from SEC filings, and short interest from FINRA. Nothing is scraped, and every figure names its source.</p>
      </details>
      <details>
        <summary class="type-heading-2">Do I need to connect my brokerage to use it?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>No. Anyone can analyze a US-listed ticker without connecting. Connecting adds Your Portfolio: your positions, their math and your own rules.</p>
      </details>
      <details>
        <summary class="type-heading-2">Do I need a card to connect my brokerage?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>No. A free account can connect one brokerage read-only, with no card and no trial. A card is only needed to start a Core or Premium trial.</p>      </details>
      <details>
        <summary class="type-heading-2">What does a connected free account actually see?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Your Portfolio in full, the same as on every plan. Every position shows its structure, net debit or credit, breakevens, max profit and max loss. Your own rules are checked on current prices, and each position lists its scenarios and paths with their math. Free also includes 10 analyses a month.</p>
      </details>
      <details>
        <summary class="type-heading-2">Do I need to create an account to use it?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>No. Anyone can analyze a US-listed ticker without an account and see the Free plan's sections. An account is for saving your rules, connecting your brokerage read-only, or starting a paid plan.</p>
      </details>
      <details>
        <summary class="type-heading-2">Is my account data shared with anyone?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>No. Your positions and account data are never shown to another user or reused for anyone else.</p>
      </details>
      <h3 class="type-caption faq__group-label">Once you're in</h3>
      <details>
        <summary class="type-heading-2">What happens when the 14-day trial ends?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Your saved card is charged your plan's monthly price, $49 for Core or $99 for Premium, plus any applicable sales tax. The plan continues without a break. We email you before the charge, and the app shows the date for the whole trial. Cancelling before then is one click in Settings. There's no charge, and the account moves to Free with your rules, broker connection and analysis history kept.</p>
      </details>
      <details>
        <summary class="type-heading-2">How do I cancel?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>One click in Settings, with no retention flow, call or form. Cancelling during a trial means no charge. On a paid plan, your plan stays on until the end of the period you've paid for, then the account moves to Free. Your rules, broker connection and analysis history are kept. Refunds are handled separately by Dodo Payments, our merchant of record. See the <a href="/refunds">Refund Policy</a>.</p>
      </details>
      <details>
        <summary class="type-heading-2">What if connecting my brokerage fails?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Nothing is connected and nothing is synced, so the account stays exactly as it was. The screen says so and offers Try again, which opens a fresh SnapTrade session. You can pick the same broker or a different one. Credentials are entered at SnapTrade, so a failed attempt leaves nothing with us.</p>
      </details>
      <details>
        <summary class="type-heading-2">What if some of the data isn't available?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>The analysis says so, in the section where the gap is. A section that couldn't be sourced is marked missing, and nothing is estimated to cover it. If an Outlook horizon lacks what it needs, that horizon shows no price.</p>
      </details>
      <details>
        <summary class="type-heading-2">How do I get support?<svg class="faq__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <p>Email support@twiceover.io. A person answers every message, and we typically reply within 1–2 business days.</p>
      </details>
    </div>
  </section>

  <section class="not-section section-ground" aria-labelledby="what-its-not">
    <h2 id="what-its-not" class="type-heading-1 section-heading">What TwiceOver is <em>not</em></h2>
    <div class="not-block">
      <p>Not an investment adviser. TwiceOver gives no recommendations or trading signals, never scores or rates a stock, and never tells you to buy or sell. It never executes a trade or holds your money. You get the evidence and the math behind our projection, and the decision stays with you.</p>
    </div>
  </section>

  {/* Closing band — primary shares the hero CTA's route and copy (site-app-seam.md §3). The trial
      disclosure lines left this band for /pricing, where the trial is started (consult 0987 §2):
      nothing on this page starts a trial. No third disclaimer line: the footer's single-source
      disclaimer covers the page once, and ci/check-content.mjs enforces that one. */}
  <section class="closing-band">
    <div class="container closing-band__inner">
      <p class="type-heading-1 closing-band__heading">See it on your own book.</p>
      <p class="closing-band__sub">Connect read-only to see your own positions, or analyze any US-listed ticker.</p>
      <p class="closing-band__body type-body">Your Portfolio comes with every plan. Free includes 10 analyses a month.</p>
      <p class="closing-band__body type-body">Core and Premium give the Outlook more to weigh. Core adds the news, market voices, earnings and the options market. Premium adds the largest options trades, earnings history and insider activity.</p>      <div class="closing-band__actions">
        <a class="btn-filled" href="/go/connect">Connect read-only →</a>
        <a class="btn-quiet" href="/pricing">Pricing</a>
      </div>
    </div>
  </section>

</Base>

{/* The typeahead mount (ADR 0810 item 6, stock-analyst-platform#2965). A plain Astro script
    element — no `is:inline` — so Astro compiles it to an external bundle under /_astro/,
    declared in ci/check-entry-box.mjs's EXPECTED_SCRIPTS and scanned there, body and
    transitively imported chunks alike. Inline is not an option: the Worker's CSP is
    script-src 'self' with no inline exception (consult 0811 Amendment 1).

    NB — the words "script element" above are spelled out deliberately. An Astro comment is
    still tokenized as HTML, so a literal script tag written inside one OPENS a real script
    element at that point: it breaks `astro dev`'s dependency scan (esbuild parses the prose
    after it as JavaScript) while `astro build` completes without complaint. Caught live here
    on 2026-08-30 — the same hazard applies to any tag name written in a comment on this page. */}
<script>
  import { mountEntryBoxTypeahead } from "../typeahead/ticker-typeahead.js";
  mountEntryBoxTypeahead();
</script>
