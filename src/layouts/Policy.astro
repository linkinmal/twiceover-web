---
// Policy template (site-prelaunch.md §4) — one template, four instances
// (/terms, /privacy, /refunds, /cookies). 70ch measure, H1 + effective-date
// caption, typography.legal body. `chrome` passes through to Base: "none" is the
// /in-app/* variant of terms, privacy and cookies (stock-analyst-platform#4033).
import Base from "./Base.astro";
import { EFFECTIVE_DATE } from "../config.mjs";

interface Props {
  title: string;
  description: string;
  heading: string;
  chrome?: "full" | "none";
  // A page added after the policy set carries its own date; the default is the shared
  // policy date (/delete-account, stock-analyst-platform#4202).
  effective?: string;
}
const { title, description, heading, chrome = "full", effective = EFFECTIVE_DATE } = Astro.props;
---
<Base title={title} description={description} chrome={chrome}>
  <article class="policy">
    <div class="page-title-block">
      <h1 class="type-heading-1">{heading}</h1>
    </div>
    <p class="effective-date">Effective {effective}</p>
    <div class="policy-body type-legal">
      <slot />
    </div>
  </article>
</Base>
