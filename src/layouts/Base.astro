---
// Global chrome (site-prelaunch.md §1): header (lockup + Pricing nav), footer
// (policy links · shared disclaimer · © line + two-tone wordmark), skip link.
// The header's reserved sign-in zone and the hero's reserved action row ship as
// layout affordances only — no markup (site-prelaunch.md §6).
import "../styles/tokens.css";
import "../styles/site.css";
import Mark from "../components/Mark.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { YEAR } from "../config.mjs";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/og-image.png", Astro.site).href;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-sans-3-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-serif-4-latin-wght-normal.woff2" crossorigin />
    {/* Source Code Pro not preloaded: tabular-numeral use deferred to app surfaces */}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="lockup" href="/">
          <Mark />
          <span class="wordmark">TwiceOver</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/pricing">Pricing</a>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label="Policies and contact">
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/refunds">Refunds</a>
          <a href="/cookies">Cookies</a>
          <a href="/contact">Contact</a>
        </nav>
        <Disclaimer />
        <div class="footer-meta">
          <span>© {YEAR} TwiceOver</span>
          <span class="wordmark">Twice<span class="o-accent">O</span>ver</span>
        </div>
      </div>
    </footer>
  </body>
</html>
