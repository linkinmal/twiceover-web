---
// Global chrome (site-prelaunch.md §1): header (lockup + Pricing nav + Sign in),
// footer (policy links · shared disclaimer · © line + two-tone wordmark), skip link.
// Sign in (#1754, site-app-seam.md §3/§4) is a same-origin /go/signin redirect —
// no app-origin link ships from the site directly (site-app-seam.md §2 rule).
import "../styles/tokens.css";
import "../styles/site.css";
import Mark from "../components/Mark.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { YEAR } from "../config.mjs";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// The live member of the rotating share-card set (ADR 0905). Three cards exist —
// /og-card-path.png, /og-card-levels.png, /og-card-spread.png, all generated by
// `npm run gen:og-cards` — and this one line names the member og:image points at.
//
// ROTATING IS THIS LINE PLUS A DEPLOY. Never point it at an overwritten file: every
// consumer caches on the URL (Meta: "Use a new URL for the new image or the image
// won't be updated"), which is exactly why there are three assets rather than one
// that changes. Never delete a retired member either — links already shared resolve
// to it. README §Rotating the share card.
const OG_CARD = "/og-card-path.png";
const ogImageURL = new URL(OG_CARD, Astro.site).href;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-sans-3-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-serif-4-latin-wght-normal.woff2" crossorigin />
    {/* Source Code Pro not preloaded: tabular-numeral use deferred to app surfaces */}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="lockup" href="/">
          <Mark />
          <span class="wordmark">TwiceOver</span>
        </a>
        <div class="site-header__actions">
          <nav class="site-nav" aria-label="Primary">
            <a href="/pricing">Pricing</a>
          </nav>
          {/* Sign in / Sign up pair, founder-directed 2026-08-22 (#2520) — site-prelaunch.md
              §1 reserved only one button; app-shell.md §1a's logged-out masthead spec is the
              pattern actually reused here: a plain-text "Sign in" link plus a "Sign up" ghost
              button, same visual weight class as .btn-quiet everywhere else on this page —
              never two competing button styles in the bar. Both open the same combined
              app.twiceover.io entry screen via /go/signin (AuthFlow.tsx: "Sign in or create
              your account" — the system doesn't know which until the visitor completes it);
              the two labels exist only so a returning visitor and a new one each scan for
              their own word. */}
          <a class="site-header__signin" href="/go/signin">Sign in</a>
          <a class="btn-quiet" href="/go/signin">Sign up</a>
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label="Policies and contact">
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/refunds">Refunds</a>
          <a href="/cookies">Cookies</a>
          <a href="/contact">Contact</a>
          {/* Trailing icon-only X link (v2.29, closing #2880/#2893) — site-prelaunch.md
              §Footer Row 1: discoverable link to @twiceover_io, right-aligned after
              Contact, no new brand mark or color — this is the platform's own logomark. */}
          <a
            class="footer-social"
            href="https://x.com/twiceover_io"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TwiceOver on X (opens in a new tab)"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M18.42 2h3.35l-7.33 8.38L23 22h-6.9l-5.4-6.62L4.5 22H1.14l7.84-8.97L1 2h7.06l4.88 6.05L18.42 2zm-1.18 18h1.86L7.6 3.9H5.6L17.24 20z"
              />
            </svg>
          </a>
        </nav>
        <Disclaimer />
        <div class="footer-meta">
          <span>© {YEAR} TwiceOver</span>
          <span class="wordmark">Twice<span class="o-accent">O</span>ver</span>
        </div>
      </div>
    </footer>
  </body>
</html>
