---
// "Guess the gap" as served (blog-handoff-playables.md section 1): one report at a time in a Ticket-theme slip. The first
// question, all five answers and the lesson are printed in full from the baked-in report set; the functions the block
// script imports (guess-gap-view.mjs beside this file) write them, so the script only moves what is already here. The
// slider, the lock and skip buttons and "Play five more" are hidden until the script runs them; with script off the
// page reads as the first question, then the five answers and the lesson.
import { REPORT_SETS, SOURCE_LINE } from "./guess-gap-reports.mjs";
import { QUESTION, barsHtml, endTitle, givenHtml, lessonBig, reportLine, scoreLine, tallyHtml } from "./guess-gap-view.mjs";

const set = REPORT_SETS[0];
---
<div data-guess>
  <section class="blk play" aria-labelledby="gg-q">
    <p class="gg-rd"><span data-rno>{reportLine(0, set.length)}</span><span data-rsc>{scoreLine(set, [])}</span></p>
    <div data-round>
      <h2 class="q" id="gg-q" data-q>{QUESTION}</h2>
      <p class="gg-given" data-given set:html={givenHtml(set[0])}></p>
      <div data-js hidden>
        <div class="gg-gr">
          <output class="gg-gv" data-gv for="gg-guess">5.0%</output>
          <input type="range" class="rng" id="gg-guess" min="0" max="30" step="0.5" value="5" aria-label="Your guess: the size of the move, in percent" />
          <span class="gg-gsc" aria-hidden="true"><i>0%</i><i>30%</i></span>
        </div>
        <div class="row"><button class="btn" type="button" data-lock>Lock in my guess</button><button class="gg-skip" type="button" data-skip>Skip to all five answers</button></div>
      </div>
      <div data-rev hidden aria-live="polite">
        <p class="gg-ans" data-ans></p>
        <div class="gg-meter" data-meter aria-hidden="true"></div>
        <p class="gg-why" data-why></p>
        <div class="row"><button class="btn" type="button" data-next>Next report</button></div>
      </div>
    </div>
    <div data-end data-nojs>
      <h2 class="q" data-eq>{endTitle([])}</h2>
      <div class="gg-score" data-score></div>
      <div class="gg-tw"><table class="gg-tally" data-tally set:html={tallyHtml(set, [])}></table></div>
      <div data-js hidden><div class="row"><button class="btn" type="button" data-again>Play five more</button></div></div>
    </div>
  </section>
  <section class="blk teach" data-lesson data-nojs>
    <p class="lab">What it shows</p>
    <p class="big" data-lbig>{lessonBig(set)}</p>
    <div class="gg-bars" data-bars role="img" aria-label="For each of the five reports, the priced move and the move that happened" set:html={barsHtml(set)}></div>
    <p class="gg-key"><span><i class="gg-sw p"></i>priced move</span><span><i class="gg-sw m"></i>move that happened</span></p>
    <p>The priced move is a size, set by what traders paid. Some reports land inside it and some land far outside. One report tells you little. The count across many reports is the thing to look at.</p>
    <p class="stamp"><span><b>Source</b> {SOURCE_LINE}</span></p>
  </section>
</div>
