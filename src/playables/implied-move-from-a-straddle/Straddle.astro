---
// "Implied move from a straddle" as served (blog-handoff-playables.md section 2): two open numbered steps in one column.
// The page opens on one fixed example (the first of six), printed in full: the sentence, the three answers, the chart
// and the result at the strike. The functions the block script imports (straddle-view.mjs beside this file) write it, so
// the script only moves what is already here. The slider, the "Try another example" button and the two typed boxes
// are hidden until the script runs them; with script off the opening example reads as a page of its own.
import { DEFAULT_EXAMPLE, EXAMPLES, runStraddle } from "./straddle.mjs";
import { STOCK_NOTE, answerHtml, chartLabel, chartSvg, money, resultHtml, sayText, sliderText, straddleNote } from "./straddle-view.mjs";

const ex = EXAMPLES[DEFAULT_EXAMPLE];
const r = runStraddle(ex.stock, ex.straddle);
if (!r.ok) throw new Error("the design's opening example must be valid");
const end = r.stockC;
const sl = sliderText(r, end);
---
<div data-straddle>
  <section class="blk calc" aria-labelledby="sd-h1">
    <h2 class="lab" id="sd-h1" data-js hidden>Step 1 · Drag the stock price</h2>
    <p class="lab" data-nojs>The example: a {money(r.straddleC)} straddle on a {money(r.stockC)} stock</p>
    <p class="tsent" data-say aria-live="polite">{sayText(r)}</p>
    <div class="sd-ans" data-ans aria-live="polite" set:html={answerHtml(r)}></div>
    <svg class="ch" data-chart viewBox="0 0 640 250" role="img" aria-label={chartLabel(r)} set:html={chartSvg(r, end)}></svg>
    <div data-js hidden>
      <input type="range" class="rng" id="sd-end" aria-label="Stock price on the straddle's last day" min={sl.min} max={sl.max} step={sl.step} value={sl.value} aria-valuetext={sl.valuetext} />
    </div>
    <p class="sd-res" data-res aria-live="polite" set:html={resultHtml(r, end)}></p>
    <div data-js hidden><div class="row"><button class="btn" type="button" data-another>Try another example</button></div></div>
    <p class="stamp"><span><b>As of</b> your numbers</span><span><b>Source</b> computed on this page. Sample examples, not quotes.</span></p>
  </section>
  <section class="blk calc" aria-labelledby="sd-h2" data-js hidden>
    <h2 class="lab" id="sd-h2">Step 2 · Type your own numbers</h2>
    <p class="pdesc">The chart above follows them.</p>
    <div class="plate">
      <div class="sd-fields">
        <div class="sd-field" data-field="stock">
          <label for="sd-stock">Stock price</label>
          <div class="in"><span aria-hidden="true">$</span><input id="sd-stock" type="text" inputmode="decimal" autocomplete="off" value={ex.stock.toFixed(2)} aria-describedby="sd-stock-n" aria-invalid="false" /></div>
          <small id="sd-stock-n">{STOCK_NOTE}</small>
        </div>
        <div class="sd-field" data-field="straddle">
          <label for="sd-strad">Straddle price, per share</label>
          <div class="in"><span aria-hidden="true">$</span><input id="sd-strad" type="text" inputmode="decimal" autocomplete="off" value={ex.straddle.toFixed(2)} aria-describedby="sd-strad-n" aria-invalid="false" /></div>
          <small id="sd-strad-n">{straddleNote(r)}</small>
        </div>
      </div>
    </div>
  </section>
  <section class="blk teach">
    <p class="lab">What it shows</p>
    <p class="big">The straddle only makes money if the stock ends outside the range its own price draws.</p>
    <p>The edges of the range are the straddle's two breakevens. That is why the price is read as a move: it is the move the stock has to beat.</p>
  </section>
</div>
