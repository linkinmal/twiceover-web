---
// "Position size and risk of ruin" as served (definition.md beside this file): two open numbered steps in one column,
// then the bars for every size at the same odds and the lesson. The page opens on the coin game's odds (60%, even
// money) at a 10% size, printed in full by the functions the block script imports (position-size-view.mjs), so the
// script only rewrites what is already here. The slider, "Try another example" and the two typed boxes are hidden
// until the script runs them; with script off the opening example, its bars and the lesson read as a page of their own.
import { DEFAULT_EXAMPLE, DEFAULT_SIZE, EXAMPLES, SIZE_MAX, SIZE_MIN, outcomes, runOdds } from "./position-size.mjs";
import { WIN_NOTE, answerHtml, barsHtml, kellyText, payoffNote, sayText, share, sliderText } from "./position-size-view.mjs";

const ex = EXAMPLES[DEFAULT_EXAMPLE];
const r = runOdds(ex.win, ex.payoff);
if (!r.ok) throw new Error("the opening example must be valid");
const sl = sliderText(DEFAULT_SIZE);
const at = (s: number) => share(outcomes(r, s).floor);
---
<div data-ruin>
  <section class="blk calc" aria-labelledby="pr-h1">
    <h2 class="lab" id="pr-h1" data-js hidden>Step 1 · Slide the size of each trade</h2>
    <p class="lab" data-nojs>The example: a {ex.win}% win chance, even money, {DEFAULT_SIZE}% of the account on each trade</p>
    <p class="tsent" data-say aria-live="polite">{sayText(r, DEFAULT_SIZE)}</p>
    <div class="sd-ans" data-ans aria-live="polite" set:html={answerHtml(r, DEFAULT_SIZE)}></div>
    <div data-js hidden>
      <input type="range" class="rng" id="pr-size" aria-label="Share of the account risked on each trade" min={SIZE_MIN} max={SIZE_MAX} step="1" value={sl.value} aria-valuetext={sl.valuetext} />
    </div>
    <div data-js hidden><div class="row"><button class="btn" type="button" data-another>Try another example</button></div></div>
    <p class="stamp"><span><b>As of</b> your numbers</span><span><b>Source</b> computed on this page. Sample odds, not anyone's record.</span></p>
  </section>
  <section class="blk calc" aria-labelledby="pr-h2" data-js hidden>
    <h2 class="lab" id="pr-h2">Step 2 · Type your own odds</h2>
    <p class="pdesc">The answer above and the bars below follow them.</p>
    <div class="plate">
      <div class="sd-fields">
        <div class="sd-field" data-field="win">
          <label for="pr-win">Win chance</label>
          <div class="in"><span aria-hidden="true">%</span><input id="pr-win" type="text" inputmode="decimal" autocomplete="off" value={String(ex.win)} aria-describedby="pr-win-n" aria-invalid="false" /></div>
          <small id="pr-win-n">{WIN_NOTE}</small>
        </div>
        <div class="sd-field" data-field="payoff">
          <label for="pr-pay">A win pays, as a share of the amount risked</label>
          <div class="in"><span aria-hidden="true">%</span><input id="pr-pay" type="text" inputmode="decimal" autocomplete="off" value={String(ex.payoff)} aria-describedby="pr-pay-n" aria-invalid="false" /></div>
          <small id="pr-pay-n">{payoffNote(r)}</small>
        </div>
      </div>
    </div>
  </section>
  <section class="blk">
    <p class="lab">The same odds at every size</p>
    <div class="sim-bars" data-bars set:html={barsHtml(r, DEFAULT_SIZE)}></div>
    <div class="lg" style="margin-top:12px">
      <span><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" fill="var(--gain)"/></svg>ended 100 trades ahead</span>
      <span><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" fill="var(--loss)"/></svg>fell to half the start</span>
      <span><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" fill="color-mix(in srgb,var(--ink) 14%,var(--plate))"/></svg>neither after 100 trades</span>
    </div>
    <p class="stamp"><span><b>As of</b> your numbers</span><span><b>Source</b> computed on this page, the exact odds of every path, no simulation</span></p>
  </section>
  <section class="blk teach">
    <p class="lab">What it shows</p>
    <p class="big">The odds stay the same in every row. Only the size changes, and it decides how the runs end.</p>
    <p>At a {ex.win}% win chance and even money, a {DEFAULT_SIZE}% size fell to half the start in {at(10)} of runs. At {kellyText(r.kelly)}, the size that grows the account fastest, it was {at(20)}. At 40% it was {at(40)}.</p>
    <p>The fastest-growing size is the edge divided by the payoff. Past it, a bigger size adds risk and takes growth away. Below it, the account grows more slowly and falls to half far less often. Traders call the question position sizing.</p>
  </section>
</div>
