{
  "name": "twiceover-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TwiceOver pre-launch compliance site — twiceover.io (ADR 0002, #39)",
  "scripts": {
    "prebuild": "node scripts/build-tokens.mjs && node scripts/build-blog-scripts.mjs",
    "build": "astro build",
    "predev": "node scripts/build-tokens.mjs && node scripts/build-blog-scripts.mjs",
    "dev": "astro dev",
    "check": "node ci/check-content.mjs",
    "check:a11y-decor": "node ci/check-a11y-decor.mjs",
    "check:entry-box": "node ci/check-entry-box.mjs",
    "check:worker": "node ci/check-worker-source.mjs",
    "check:fonts": "node ci/blog-fonts.mjs",
    "check:style": "node ci/blog-style.mjs",
    "check:isolation": "node ci/blog-isolation.mjs",
    "check:addresses": "node ci/check-stable-addresses.mjs",
    "check:share": "node scripts/gen-blog-share.mjs --check",
    "gen:blog-share": "node scripts/gen-blog-share.mjs",
    "test": "vitest run",
    "gen:favicons": "node scripts/gen-favicons.mjs",
    "gen:og-cards": "node scripts/gen-og-cards.mjs",
    "pregen:og-cards": "node scripts/build-tokens.mjs",
    "symbol-index:generate": "node scripts/gen-symbol-index.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/besley": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
